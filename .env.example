# Database (Milestone 3 — Neon Postgres via Vercel Marketplace)
# DATABASE_URL is the pooled connection (used by the running app).
DATABASE_URL="postgresql://user:password@localhost:5432/chaobao"
# DATABASE_URL_UNPOOLED is the direct connection (used by `prisma migrate`/`db seed`).
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/chaobao"

# Auth (Milestone 4 — Auth.js / NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth app — create at https://console.cloud.google.com/apis/credentials
# Redirect URI: <site-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments (Milestone 4 — Stripe via Vercel Marketplace)
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# From `stripe listen` (dev) or a Stripe Dashboard webhook endpoint (prod)
STRIPE_WEBHOOK_SECRET=""

# Media — future milestone, not wired yet
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (transactional) — future milestone, not wired yet
RESEND_API_KEY=re_1234
EMAIL_FROM=youremail@gmail.com
# Rate limiting (Upstash Redis) — future milestone, not wired yet
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
