# Database (Milestone 3 — Neon Postgres via Vercel Marketplace)
# DATABASE_URL is the pooled connection (used by the running app).
DATABASE_URL="postgresql://user:password@localhost:5432/chaobao"
# DATABASE_URL_UNPOOLED is the direct connection (used by `prisma migrate`/`db seed`).
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/chaobao"

# Auth (Milestone 2 — NextAuth)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Media
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (transactional)
RESEND_API_KEY=""

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
